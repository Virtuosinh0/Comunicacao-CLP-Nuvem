<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DataManager.Service</RootNamespace>
    <AssemblyName>DataManager.Service</AssemblyName>
    <OutputType>exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UserSecretsId>dotnet-DataManager.Service-6f1c2a9e-3b7d-4e5a-9c41-2d8b7e0f5a13</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <!-- Sharp7: port oficial em C# do Snap7 (protocolo S7 da Siemens), 100% gerenciado, sem snap7.dll nativa. -->
    <PackageReference Include="Sharp7" Version="1.1.84" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Config\plc-tags.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Config\plc-tags.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
